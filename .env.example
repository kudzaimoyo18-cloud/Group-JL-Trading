# Copy to .env.local and fill in. All are OPTIONAL — the site builds and runs
# without them (the contact form falls back to the WhatsApp button).

# Public base URL of the deployment (used for canonical URLs, sitemap, OG tags).
# Set this in Vercel to your real domain once deployed.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Resend — enables the contact form to email submissions.
# Get a free key at https://resend.com
RESEND_API_KEY=

# Optional overrides for the contact email routing.
# CONTACT_FROM must be a Resend-verified sender (or onboarding@resend.dev for tests).
CONTACT_FROM="Group JL Trading <onboarding@resend.dev>"
CONTACT_TO=contact@jlgrouptrading.com
